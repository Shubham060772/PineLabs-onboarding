{
  "name": "onboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "seed": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/reset.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "fixtures": "tsx scripts/fixtures.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:restart": "tsx scripts/verify-restart.ts",
    "ai:setup": "tsx scripts/setup-ai.ts",
    "ai:start": "tsx scripts/start-ai.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "test:stress": "tsx scripts/stress.ts",
    "test:stress:ai": "tsx scripts/stress-ai.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "@tanstack/react-query": "^5.90.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.1.91",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "18.7.0-beta.19",
    "node": "^22.23.5",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  }
}
